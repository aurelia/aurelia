{
  "$schema": "https://raw.githubusercontent.com/Polymer/tachometer/master/config.schema.json",
  "root": "..",
  "benchmarks": [
    {
      "browser": { "name": "chrome", "headless": true, "addArguments": ["--disable-gpu", "--disable-dev-shm-usage", "--no-sandbox"] },
      "measurement": { "name": "perf", "mode": "performance", "entryName": "i18n-formatting-default-refresh-1000" },
      "expand": [
        { "name": "i18n default formatting refresh 1000 base", "url": "refresh1000.html?variant=base" },
        { "name": "i18n default formatting refresh 1000 candidate", "url": "refresh1000.html?variant=candidate" }
      ]
    },
    {
      "browser": { "name": "chrome", "headless": true, "addArguments": ["--disable-gpu", "--disable-dev-shm-usage", "--no-sandbox"] },
      "measurement": { "name": "perf", "mode": "performance", "entryName": "i18n-formatting-explicit-refresh-1000" },
      "expand": [
        { "name": "i18n explicit formatting refresh 1000 base", "url": "refresh1000.html?variant=base&options=explicit" },
        { "name": "i18n explicit formatting refresh 1000 candidate", "url": "refresh1000.html?variant=candidate&options=explicit" }
      ]
    }
  ],
  "timeout": 0.5
}
