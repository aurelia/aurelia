{
  "$schema": "https://raw.githubusercontent.com/Polymer/tachometer/master/config.schema.json",
  "root": "..",
  "benchmarks": [
    {
      "browser": {
        "name": "chrome",
        "headless": true,
        "addArguments": [
          "--disable-gpu",
          "--disable-dev-shm-usage",
          "--no-sandbox"
        ]
      },
      "measurement": {
        "name": "perf",
        "mode": "performance",
        "entryName": "dependency-rotation-250000"
      },
      "expand": [
        {
          "name": "fresh binding dependency rotation 250000 base",
          "url": "dependencyRotation250000.html?variant=base"
        },
        {
          "name": "fresh binding dependency rotation 250000 candidate",
          "url": "dependencyRotation250000.html?variant=candidate"
        }
      ]
    },
    {
      "browser": {
        "name": "chrome",
        "headless": true,
        "addArguments": [
          "--disable-gpu",
          "--disable-dev-shm-usage",
          "--no-sandbox"
        ]
      },
      "measurement": {
        "name": "perf",
        "mode": "performance",
        "entryName": "dependency-rotation-cached-1000000"
      },
      "expand": [
        {
          "name": "cached binding dependency rotation 1000000 base",
          "url": "dependencyRotationCached1000000.html?variant=base"
        },
        {
          "name": "cached binding dependency rotation 1000000 candidate",
          "url": "dependencyRotationCached1000000.html?variant=candidate"
        }
      ]
    },
    {
      "browser": {
        "name": "chrome",
        "headless": true,
        "addArguments": [
          "--enable-precise-memory-info",
          "--disable-gpu",
          "--disable-dev-shm-usage",
          "--no-sandbox"
        ]
      },
      "measurement": [
        {
          "name": "perf",
          "mode": "performance",
          "entryName": "realistic-refresh-1000"
        },
        {
          "name": "used JS heap",
          "mode": "expression",
          "expression": "window.usedJSHeapSizeBytes"
        }
      ],
      "expand": [
        {
          "name": "realistic keyed refresh 1000 base",
          "url": "refresh1000.html?variant=base"
        },
        {
          "name": "realistic keyed refresh 1000 candidate",
          "url": "refresh1000.html?variant=candidate"
        }
      ]
    },
    {
      "browser": {
        "name": "chrome",
        "headless": true,
        "addArguments": [
          "--enable-precise-memory-info",
          "--disable-gpu",
          "--disable-dev-shm-usage",
          "--no-sandbox"
        ]
      },
      "measurement": [
        {
          "name": "perf",
          "mode": "performance",
          "entryName": "realistic-mixed-1000"
        },
        {
          "name": "used JS heap",
          "mode": "expression",
          "expression": "window.usedJSHeapSizeBytes"
        }
      ],
      "expand": [
        {
          "name": "realistic mixed reconciliation 1000 base",
          "url": "mixed1000.html?variant=base"
        },
        {
          "name": "realistic mixed reconciliation 1000 candidate",
          "url": "mixed1000.html?variant=candidate"
        }
      ]
    }
  ],
  "timeout": 0.5
}
