{
  "$schema": "https://raw.githubusercontent.com/Polymer/tachometer/master/config.schema.json",
  "root": "..",
  "benchmarks": [
    {
      "browser": {
        "name": "chrome",
        "headless": true,
        "addArguments": ["--enable-precise-memory-info"]
      },
      "measurement": [
        { "name": "perf", "mode": "performance", "entryName": "startup-100-big-template" }
      ],
      "expand": [
        {
          "name": "big-template startup 100 base",
          "url": "startup100-big-template.html?variant=base"
        },
        {
          "name": "big-template startup 100 candidate",
          "url": "startup100-big-template.html?variant=candidate"
        }
      ]
    }
  ],
  "timeout": 0.15
}
