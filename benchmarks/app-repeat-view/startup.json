{
  "$schema": "https://raw.githubusercontent.com/Polymer/tachometer/master/config.schema.json",
  "root": "..",
  
  "benchmarks": [
    {
      "browser": {
        "name": "chrome",
        "headless": true,
        "addArguments": [
          "--enable-precise-memory-info",
          "--disable-gpu",
          "--disable-dev-shm-usage",
          "--no-sandbox"
        ]
      },
      "measurement": [
        { "name": "perf", "mode": "performance", "entryName": "startup-10k" },
        { "name": "used JS heap", "mode": "expression", "expression": "usedJSHeapSizeBytes" }
      ],
      "expand": [
        {
          "name": "startup base",
          "url": "startup10k.html?variant=base"
        },
        {
          "name": "startup candidate",
          "url": "startup10k.html?variant=candidate"
        }
      ]
    }
  ],
  "timeout": 0.15
}
