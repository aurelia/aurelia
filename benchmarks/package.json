{
  "name": "@aurelia/benchmarks",
  "private": true,
  "type": "module",
  "scripts": {
    "bench:variants": "node prepare-variants.mjs",
    "bench:variants:test": "node --test variant-utils.spec.mjs",
    "bench:test": "node --test variant-utils.spec.mjs benchmark-page.spec.mjs benchmark-summary.spec.mjs benchmark-report.spec.mjs ../.github/scripts/benchmark-comment.spec.cjs",
    "bench:report": "node write-benchmark-report.mjs --results results --output results/report",
    "bench": "npm run bench:rerender10k && npm run bench:startup10k && npm run bench:update1k && npm run bench:rerender500-big && npm run bench:startup100-big",
    "bench:rerender10k": "node run-tachometer.mjs --config app-repeat-view/rerender.json --json-file results/repeat-view-rerender-10k.json",
    "bench:startup10k": "node run-tachometer.mjs --config app-repeat-view/startup.json --json-file results/repeat-view-startup-10k.json",
    "bench:update1k": "node run-tachometer.mjs --config app-repeat-view/update-1k.json --json-file results/repeat-view-update-1k.json",
    "bench:rerender500-big": "node run-tachometer.mjs --config app-repeat-view-big-template/rerender-500-big-template.json --json-file results/repeat-view-rerender-500-big-template.json",
    "bench:startup100-big": "node run-tachometer.mjs --config app-repeat-view-big-template/startup-100-big-template.json --json-file results/repeat-view-startup-100-big-template.json",
    "bench:rerender10k-ce": "node run-tachometer.mjs --config app-repeat-ce/rerender-ce.json --json-file results/repeat-ce-rerender-10k.json",
    "bench:startup10k-ce": "node run-tachometer.mjs --config app-repeat-ce/startup-ce.json --json-file results/repeat-ce-startup-10k.json",
    "bench:repeat-expr": "node run-tachometer.mjs --config app-repeat-view-keyed-expr/bench.json --json-file results/app-repeat-view-keyed-expr.json",
    "bench:repeat-string": "node run-tachometer.mjs --config app-repeat-view-keyed-string/bench.json --json-file results/app-repeat-view-keyed-string.json"
  },
  "dependencies": {
    "tachometer": "0.7.1"
  },
  "version": "2.0.0-beta.25"
}
