    "test:e2e:debugger": "cross-env APP_PORT=9015 PWDEBUG=1 concurrently \"npm run dev\" \"playwright-watch test\"",
    "test": "npm run test:e2e",
    "test:watch": "npm run test:e2e:watch"
  },
