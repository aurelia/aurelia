  "private": true,
  "engines": {
    "node": ">=14.15.0",
    "npm": ">=6.14.8"
  },
  "version": "2.0.0-beta.25",
  "port": 9008,
  "scripts": {
    "dev": "vite dev --force",
    "test:e2e": "cross-env APP_PORT=9008 concurrently -n app,test \"npm run dev\" \"playwright test\" --kill-others --success first",
    "test:e2e:watch": "cross-env APP_PORT=9008 concurrently -n app,test \"npm run dev\" \"playwright test --ui\"",
    "test:e2e:debugger": "cross-env APP_PORT=9008 concurrently -n app,test \"npm run dev\" \"playwright test --debug\"",
    "test": "npm run test:e2e",
    "test:watch": "npm run test:e2e:watch"
  },
  "dependencies": {
    "@aurelia/kernel": "2.0.0-rc.2",
    "@aurelia/metadata": "2.0.0-rc.2",
    "@aurelia/platform": "2.0.0-rc.2",
    "@aurelia/platform-browser": "2.0.0-rc.2",
    "@aurelia/router-direct": "2.0.0-rc.2",
    "@aurelia/router": "2.0.0-rc.2",
    "@aurelia/runtime-html": "2.0.0-rc.2",
    "@aurelia/runtime": "2.0.0-rc.2",
    "@aurelia/ui-virtualization": "2.0.0-rc.2"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "webpack-cli": "^5.1.4",
    "webpack": "^5.90.3",
    "html-webpack-plugin": "^5.5.0",
    "@aurelia/webpack-loader": "2.0.0-rc.2",
    "ts-loader": "^9.3.0",
    "@types/node": "22.20.1",
    "playwright": "1.62.1",
    "typescript": "5.9.2"
  }
